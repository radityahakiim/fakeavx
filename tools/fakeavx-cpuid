#!/bin/sh
# fakeavx-cpuid - manage the list of cpuid instructions fakeavx answers for.
#
# Normally nothing here needs to be run by hand: the module looks at every
# program before it starts (and at a library when it first hits an unsupported
# instruction) and finds the cpuid instructions itself; an installed system
# saves and restores what it found across reboots (fakeavx.service).
#
#   fakeavx-cpuid list [-a]       files whose CPUID is answered (-a: also the
#                                 programs that were checked and need nothing)
#   fakeavx-cpuid add FILE        register FILE's cpuid instructions now, so that
#                                 even its first run sees the emulated features
#                                 (needs objdump and gawk)
#   fakeavx-cpuid avx FILE        make CPUID report AVX/AVX2 to FILE
#   fakeavx-cpuid scan FILE       only print the file offsets, one per line
#   fakeavx-cpuid save [CACHE]    write the module's list to CACHE
#   fakeavx-cpuid restore [CACHE] give a saved list back to the module; entries
#                                 for files that changed since are dropped
#   fakeavx-cpuid clear           make the module forget everything
#
# CACHE defaults to /var/cache/fakeavx/sites.
set -e
P=/sys/module/fakeavx/parameters
PROC=/proc/fakeavx/sites
CACHE=${2:-/var/cache/fakeavx/sites}

need_module() {
	[ -d "$P" ] || { echo "the fakeavx module is not loaded" >&2; exit 1; }
}

scan() {
	f=$1
	# executable LOAD segments: file offset, virtual address, size in file
	segs=$(LC_ALL=C readelf -lW "$f" | awk '$1 == "LOAD" && / R?W?E / { print $2, $3, $5 }')
	[ -n "$segs" ] || { echo "$f: no executable segment found" >&2; exit 1; }
	LC_ALL=C objdump -d --no-show-raw-insn "$f" |
	gawk -v segs="$segs" '
	BEGIN {
		n = split(segs, s, /[ \n]+/) / 3
		for (i = 0; i < n; i++) {
			off[i] = strtonum(s[3 * i + 1]); va[i] = strtonum(s[3 * i + 2]); sz[i] = strtonum(s[3 * i + 3])
		}
	}
	$2 == "cpuid" {
		a = $1; sub(/:$/, "", a); a = strtonum("0x" a)
		for (i = 0; i < n; i++)
			if (a >= va[i] && a < va[i] + sz[i])
				printf "%x\n", a - va[i] + off[i]
	}'
}

write_param() {	# name value
	if [ -w "$P/$1" ]; then
		printf '%s\n' "$2" > "$P/$1"
	else
		printf '%s\n' "$2" | sudo tee "$P/$1" > /dev/null
	fi
}

case "$1" in
list)
	need_module
	awk -v all="$([ "$2" = -a ] && echo 1)" '
	$1 == "clean" { sub(/^[^ ]+ /, ""); if (all) clean[$0] = 1; next }
	$1 == "scanned" { sub(/^[^ ]+ /, ""); seen[$0] = 1; next }
	$1 == "avx" { sub(/^[^ ]+ /, ""); seen[$0] = 1; avx[$0] = 1; next }
	{ sub(/^[^ ]+ /, ""); seen[$0] = 1; n[$0]++ }
	END {
		for (p in seen) printf "%5d cpuid sites%s  %s\n", n[p], avx[p] ? ", reports AVX" : "", p
		for (p in clean) printf "    needs nothing  %s\n", p
	}' "$PROC"
	;;
scan)
	[ -f "$2" ] || { echo "usage: $0 scan FILE" >&2; exit 1; }
	scan "$2"
	;;
add)
	[ -f "$2" ] || { echo "usage: $0 add FILE" >&2; exit 1; }
	need_module
	f=$(readlink -f "$2")
	echo "scanning $f for cpuid instructions..." >&2
	n=0
	for off in $(scan "$f"); do
		write_param cpuid_site "$off $f"
		n=$((n + 1))
	done
	write_param cpuid_site "scanned $f"
	echo "$n cpuid sites registered for $f"
	;;
avx)
	[ -f "$2" ] || { echo "usage: $0 avx FILE" >&2; exit 1; }
	need_module
	write_param cpuid_site "avx $(readlink -f "$2")"
	;;
save)
	need_module
	mkdir -p "$(dirname "$CACHE")"
	cur=$(mktemp)
	trap 'rm -f "$cur"' EXIT
	cat "$PROC" > "$cur"
	{
		# remember what each file looked like, to notice later if it changed
		sed 's/^[^ ]* //' "$cur" | sort -u | tr '\n' '\0' |
			xargs -0 -r stat -c 'stat %s.%Y %n' -- 2>/dev/null || true
		cat "$cur"
	} > "$CACHE.tmp"
	mv "$CACHE.tmp" "$CACHE"
	;;
restore)
	need_module
	[ -f "$CACHE" ] || exit 0
	now=$(mktemp)
	ok=$(mktemp)
	trap 'rm -f "$now" "$ok"' EXIT
	# what the files look like now; then keep the entries of unchanged files
	sed -n 's/^stat [^ ]* //p' "$CACHE" | tr '\n' '\0' |
		xargs -0 -r stat -c '%s.%Y %n' -- 2>/dev/null > "$now" || true
	awk 'FNR == NR { p = $0; sub(/^[^ ]+ /, "", p); now[p] = $1; next }
	$1 == "stat" { p = $0; sub(/^stat [^ ]+ /, "", p); if (now[p] == $2) ok[p] = 1; next }
	{ p = $0; sub(/^[^ ]+ /, "", p); if (ok[p]) print }' "$now" "$CACHE" > "$ok"
	while IFS= read -r line; do
		write_param cpuid_site "$line" || true
	done < "$ok"
	n=$(wc -l < "$ok")
	echo "fakeavx: $n cached entries restored"
	;;
clear)
	need_module
	write_param cpuid_clear 1
	;;
*)
	sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
esac
